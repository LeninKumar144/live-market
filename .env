# Copy to `.env` and fill in values.

# Required: OAuth access token (generate from Upstox Developer Apps, or exchange auth code — see README)
UPSTOX_ACCESS_TOKEN=eyJ0eXAiOiJKV1QiLCJrZXlfaWQiOiJza192MS4wIiwiYWxnIjoiSFMyNTYifQ.eyJzdWIiOiI0WkNTQloiLCJqdGkiOiI2OWM1Zjg2ODllYzNlYTZjNjY3ZmY5ZmEiLCJpc011bHRpQ2xpZW50IjpmYWxzZSwiaXNQbHVzUGxhbiI6ZmFsc2UsImlzRXh0ZW5kZWQiOnRydWUsImlhdCI6MTc3NDU4MTg2NCwiaXNzIjoidWRhcGktZ2F0ZXdheS1zZXJ2aWNlIiwiZXhwIjoxODA2MTg0ODAwfQ.EY6bm80l8MeclX3L2dXYtlZE6NCxaD5mMwZKjPffcrY

# Optional: override API host (default https://api.upstox.com/v2)
# UPSTOX_API_BASE=https://api.upstox.com/v2

# NIFTY underlying key (default matches Upstox docs)
# NIFTY_INSTRUMENT_KEY=NSE_INDEX|Nifty 50

# Optional: pin a single expiry (YYYY-MM-DD). If empty, nearest future expiry is used.
# OPTION_EXPIRY_DATE=2025-03-27

# Telegram (optional but recommended for alerts)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: override poll interval / cooldown (seconds). YAML `config/analysis.yaml` is the primary tuner.
# POLL_INTERVAL_SECONDS=7
# SIGNAL_COOLDOWN_SECONDS=180

# Logs directory (relative to project root)
# LOG_DIR=logs
