# Copy to `.env` and fill in values.

# Dev: API port for FastAPI + Vite proxy (default 8787 — avoids Windows WinError 10013 on 8000).
# API_PORT=8000

# Required: OAuth access token (generate from Upstox Developer Apps, or exchange auth code — see README)
UPSTOX_ACCESS_TOKEN=

# Optional: override API host (default https://api.upstox.com/v2)
# UPSTOX_API_BASE=https://api.upstox.com/v2

# --- Multi-segment underlyings (OI dashboards) ---
# Comma list polled by the background OI loop (default: all four)
# OI_SEGMENTS=nifty,banknifty,sensex,mcx

# NIFTY underlying key (default matches Upstox docs)
# NIFTY_INSTRUMENT_KEY=NSE_INDEX|Nifty 50
# NIFTY_STRIKE_STEP=50
# NIFTY_OPTION_LOT_SIZE=65
# NIFTY_FLAT_THRESHOLD=8.0

# BANKNIFTY
# BANKNIFTY_INSTRUMENT_KEY=NSE_INDEX|Nifty Bank
# BANKNIFTY_STRIKE_STEP=100
# BANKNIFTY_OPTION_LOT_SIZE=15
# BANKNIFTY_FLAT_THRESHOLD=25.0

# SENSEX (BSE)
# SENSEX_INSTRUMENT_KEY=BSE_INDEX|SENSEX
# SENSEX_STRIKE_STEP=100
# SENSEX_OPTION_LOT_SIZE=10
# SENSEX_FLAT_THRESHOLD=40.0

# MCX Crude Oil — Upstox does NOT provide MCX option-chain; dashboard uses futures-only mode.
# Optionally pin the near-month future key so search is not required:
# MCX_INSTRUMENT_KEY=MCX_FO|426268
# MCX_SEARCH_QUERY=CRUDEOIL
# MCX_STRIKE_STEP=50
# MCX_OPTION_LOT_SIZE=100
# MCX_FLAT_THRESHOLD=5.0

# Optional: pin a single expiry (YYYY-MM-DD) for NIFTY only. If empty, nearest future expiry is used.
# OPTION_EXPIRY_DATE=2025-03-27

# Optional: override NIFTY Excel path (other segments use exports/{segment}_*.xlsx)
# OI_EXCEL_PATH=
# OI_EXCEL_INTERVAL_SECONDS=60
# OI_AUTO_UPDATE=1

# Telegram (optional but recommended for alerts)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: override poll interval / cooldown (seconds). YAML `config/analysis.yaml` is the primary tuner.
# POLL_INTERVAL_SECONDS=7
# SIGNAL_COOLDOWN_SECONDS=180

# Logs directory (relative to project root)
# LOG_DIR=logs
